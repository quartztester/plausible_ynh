# Plausible per-instance environment (rendered by ynh_config_add).
# chmod 600 __APP__ only — contains SECRET_KEY_BASE and DB/CH passwords.

# ---- required ----
BASE_URL=https://__DOMAIN__
SECRET_KEY_BASE=__SECRET_KEY_BASE__
APP_VERSION=3.2.1

# ---- listen ----
LISTEN_IP=127.0.0.1
HTTP_PORT=__PORT__

# ---- PostgreSQL (YunoHost-managed) ----
DATABASE_URL=postgres://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__

# ---- ClickHouse (native deb, loopback) ----
CLICKHOUSE_DATABASE_URL=http://default:__CH_PASSWORD__@127.0.0.1:8123/plausible_events_db

# ---- registration ----
DISABLE_REGISTRATION=__DISABLE_REGISTRATION__

# ---- mail (YunoHost Postfix on loopback, no auth) ----
MAILER_ADAPTER=Bamboo.SMTPAdapter
SMTP_HOST_ADDR=127.0.0.1
SMTP_HOST_PORT=25
MAILER_EMAIL=plausible@__DOMAIN__
MAILER_NAME="Plausible Analytics"

# ---- TOTP (2FA) vault key ----
TOTP_VAULT_KEY=__TOTP_VAULT_KEY__

# ---- storage ----
DATA_DIR=__DATA_DIR__
TMPDIR=__DATA_DIR__/tmp
PERSISTENT_CACHE_DIR=__DATA_DIR__

# ---- logging ----
LOG_LEVEL=notice
LOG_FORMAT=standard
