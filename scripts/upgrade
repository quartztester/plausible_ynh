#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================

ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action=stop

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

ynh_script_progression "Upgrading source files (native release)..."

# env file holds the secrets; back it up, swap the release, re-render from
# template with existing settings so secrets stay stable across upgrades.
ynh_backup_if_checksum_is_different --file="$install_dir/env"

ynh_setup_source --dest_dir="$install_dir/app" --full_replace

ynh_script_progression "Re-applying configuration..."

# Re-render env with the SAME secrets as the running install (settings are
# the source of truth: db_pwd/ch_password/secret_key_base/totp_vault_key).
# If ch_password were regenerated here, users.d and the running ClickHouse
# would keep authenticating with the old value while the app used the new
# one — every event flush would fail with CH 516 auth errors.
secret_key_base=$(ynh_app_setting_get --app=$app --key=secret_key_base)
totp_vault_key=$(ynh_app_setting_get --app=$app --key=totp_vault_key)
ch_password=$(ynh_app_setting_get --app=$app --key=ch_password)
[ -n "$secret_key_base" ] || ynh_die "Missing secret_key_base in app settings"
[ -n "$ch_password" ] || ynh_die "Missing ch_password in app settings"

ynh_delete_file_checksum --file="$install_dir/env"
ynh_config_add --template=env --destination="$install_dir/env"
chown "$app:$app" "$install_dir/env"
chmod 600 "$install_dir/env"

# Keep users.d in sync with the settings password (idempotent no-op when
# unchanged) and restart CH so an already-running server reloads it.
ynh_config_add --template="clickhouse-users.xml" --destination="/etc/clickhouse-server/users.d/${app}-default-password.xml"
chown clickhouse:clickhouse "/etc/clickhouse-server/users.d/${app}-default-password.xml"
chmod 600 "/etc/clickhouse-server/users.d/${app}-default-password.xml"
ynh_systemctl --service=clickhouse-server --action=restart
wait_for_url http://127.0.0.1:8123/ping 200 60 \
    || ynh_die "ClickHouse HTTP interface did not become ready on 127.0.0.1:8123"

chmod -R o-rwx "$install_dir"
chmod 755 "$install_dir/app/bin/"* "$install_dir/app/"erts-*/bin/* 2>/dev/null || true
chown -R "$app:$app" "$install_dir/app"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================

ynh_script_progression "Upgrading system configurations related to $app..."

if ! ynh_hide_warnings yunohost service status "$app" >/dev/null 2>&1; then
    yunohost service add "$app" --description="Plausible Analytics dashboard, API and event ingestion"
fi
if ! ynh_hide_warnings yunohost service status clickhouse-server >/dev/null 2>&1; then
    yunohost service add clickhouse-server --description="Column-oriented database for Plausible events"
fi

ynh_config_add_systemd
ynh_config_add_nginx

#=================================================
# MIGRATE DATABASES
#=================================================

ynh_script_progression "Running database migrations..."

# Source the env file in a subshell as the app user. Values are
plausible_ctl "eval Plausible.Release.interweave_migrate"

# Re-run the SSO account provisioning (idempotent): covers cases where
# the admin_email setting changed, or an earlier version was installed
# before this provisioning existed.
#
# NOTE: this MUST run via `rpc`, not `eval`: `eval` boots a clean node
# where Plausible.Repo is not started, so provision_user raised
# "(RuntimeError) could not lookup Ecto repo" there and the step was a
# silent no-op since the first release. `rpc` executes on the live node.
ynh_script_progression "Ensuring the SSO admin account exists..."
admin_email=$(ynh_app_setting_get --app=$app --key=admin_email)
admin=$(ynh_app_setting_get --app=$app --key=admin)

# Self-heal: Plausible keys accounts by email and YunohostSSOPlug matches
# the SSOwat-injected YNH_USER_EMAIL (the account's LDAP mail). If the
# admin's YunoHost email was changed after install (yunohost user update),
# the stored admin_email — and the Plausible account itself — go stale and
# SSO auto-login silently drops to the password form (whose password is
# randomly generated and unusable). Realign both.
if [ -n "$admin" ]; then
    current_email=$(yunohost user info "$admin" --output-as json 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("mail",""))' 2>/dev/null || echo "")
    if [ -n "$current_email" ] && [ "$current_email" != "$admin_email" ]; then
        ynh_print_warn --message="Admin email changed ($admin_email -> $current_email); realigning the Plausible account..."
        sudo -u postgres psql plausible -v ON_ERROR_STOP=1 \
            -c "UPDATE users SET email='$current_email', updated_at=now() WHERE email='$admin_email';" \
            || ynh_print_warn --message="Could not rename the Plausible admin account (non-fatal)"
        admin_email="$current_email"
        ynh_app_setting_set --app=$app --key=admin_email --value="$admin_email"
    fi
fi

if [ -n "$admin_email" ]; then
    admin_fullname=$(ynh_user_get_info --username="$admin" --key=fullname 2>/dev/null || echo "")
    provision_expr="Plausible.Release.YunohostSetup.provision_user(\"$admin_email\", \"$admin_fullname\")"
    ynh_exec_as_app bash -c "set -a; source '$install_dir/env'; set +a; cd '$data_dir'; \
        '$install_dir/app/bin/plausible' rpc '$provision_expr'" \
        || ynh_print_warn --message="Could not re-provision the SSO account (non-fatal)"
fi

#=================================================
# RESTART SERVICES
#=================================================

ynh_script_progression "Restarting $app..."

ynh_systemctl --service="$app" --action=start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
