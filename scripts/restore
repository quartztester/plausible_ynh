#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE FILES
#=================================================

ynh_script_progression "Restoring the app files..."

ynh_restore "$install_dir/app"
ynh_restore "$data_dir"
ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
ynh_restore "/etc/clickhouse-server/config.d/${app}-low-resources.xml"
ynh_restore "/etc/clickhouse-server/config.d/${app}-server.xml"
ynh_restore "/etc/clickhouse-server/users.d/${app}-default-password.xml"

# ynh_restore makes /etc files root:root 400 — nginx (www-data) couldn't read the vhost conf.
chown root:www-data "/etc/nginx/conf.d/$domain.d/$app.conf"
chmod 640 "/etc/nginx/conf.d/$domain.d/$app.conf"

# The CH daemon dies with 'Access to file denied' unless it can read its drop-ins.
chown clickhouse:clickhouse \
    "/etc/clickhouse-server/config.d/${app}-low-resources.xml" \
    "/etc/clickhouse-server/config.d/${app}-server.xml" \
    "/etc/clickhouse-server/users.d/${app}-default-password.xml"
chmod 640 \
    "/etc/clickhouse-server/config.d/${app}-low-resources.xml" \
    "/etc/clickhouse-server/config.d/${app}-server.xml"
chmod 600 "/etc/clickhouse-server/users.d/${app}-default-password.xml"

# ynh_restore root:roots (mode 400) any dir other than $install_dir/$data_dir — keep $install_dir/app app-owned, traversable, ERTS exec bits intact.
chown -R "$app:$app" "$install_dir"
chmod 750 "$install_dir"
chmod -R u=rwX,go-rwx "$install_dir/app"

# Re-render env instead of restoring the archive: re-provisioned resources may change db_pwd; lasting secrets (SECRET_KEY_BASE/TOTP_VAULT_KEY) come from app settings.
secret_key_base=$(ynh_app_setting_get --app=$app --key=secret_key_base)
totp_vault_key=$(ynh_app_setting_get --app=$app --key=totp_vault_key)
if [ -z "$secret_key_base" ] || [ -z "$totp_vault_key" ]; then
    ynh_die "Missing SECRET_KEY_BASE/TOTP_VAULT_KEY in app settings; cannot re-render env"
fi
ynh_delete_file_checksum --file="$install_dir/env"
ynh_config_add --template=env --destination="$install_dir/env"
chown "$app:$app" "$install_dir/env"
chmod 600 "$install_dir/env"

#=================================================
# RESTORE THE POSTGRESQL DATABASE
#=================================================

ynh_script_progression "Restoring the PostgreSQL database..."

ynh_psql_db_shell "$db_name" <<< "CREATE EXTENSION IF NOT EXISTS citext;"
ynh_psql_db_shell "$db_name" < ./db.sql

#=================================================
# RESTORE THE CLICKHOUSE DATABASE
#=================================================

ynh_script_progression "Restoring the ClickHouse events database..."

ch_password=$(ynh_app_setting_get --app=$app --key=ch_password)

# Reload CH BEFORE any plausible_ctl: one still running holds the previous password in memory.
ynh_systemctl --service=clickhouse-server --action=restart

plausible_ctl "eval Plausible.Release.createdb"

# Migrations recreate schemas + views; the loop below re-imports rows for the dumped real tables.
plausible_ctl "eval Plausible.Release.interweave_migrate"

for f in ./clickhouse/*.native; do
    [ -e "$f" ] || continue
    # Skip empty dumps — CH rejects zero-row INSERTs (NO_DATA_TO_INSERT).
    [ -s "$f" ] || continue
    table=$(basename "$f" .native)
    clickhouse-client --password "$ch_password" \
        --query "INSERT INTO plausible_events_db.\"$table\" FORMAT Native" < "$f"
done

#=================================================
# RE-APPLY PERMISSIONS & RESTART SERVICES
#=================================================

ynh_script_progression "Restarting services..."

if ! ynh_hide_warnings yunohost service status "$app" >/dev/null 2>&1; then
    yunohost service add "$app" --description="Plausible Analytics dashboard, API and event ingestion"
fi
if ! ynh_hide_warnings yunohost service status clickhouse-server >/dev/null 2>&1; then
    yunohost service add clickhouse-server --description="Column-oriented database for Plausible events"
fi

chown -R "$app:$app" "$install_dir" "$data_dir"
ynh_systemctl --service=clickhouse-server --action=restart
ynh_systemctl --service="$app" --action=restart

# BEAM cache warmers take ~20s past 'active' — wait before serving traffic.
wait_for_url "http://127.0.0.1:$port/js/script.js" 200 90 \
    || ynh_die "Plausible did not come back after restore"

# Restoring the conf file does not reload nginx — reload explicitly.
ynh_systemctl --service=nginx --action=reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restore of $app completed"
