#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# DECLARE FILES TO BACK UP
#=================================================

ynh_script_progression "Declaring files to be backed up..."

# App release + per-instance state. The release (48 MB) is included so
# restore works even if the source host is unreachable (e.g. disaster
# recovery on a fresh server).
ynh_backup "$install_dir/app"
ynh_backup "$install_dir/env"

# Plausible state: session cache, tmp.
ynh_backup "$data_dir"

# System conf.
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"
ynh_backup "/etc/clickhouse-server/config.d/${app}-low-resources.xml"
ynh_backup "/etc/clickhouse-server/config.d/${app}-server.xml"
ynh_backup "/etc/clickhouse-server/users.d/${app}-default-password.xml"

#=================================================
# BACK UP DATABASES
#=================================================

ynh_script_progression "Dumping the PostgreSQL database..."

mkdir -p ./clickhouse
ynh_psql_dump_db > db.sql

ynh_script_progression "Dumping the ClickHouse events database..."

ch_password=$(ynh_app_setting_get --app=$app --key=ch_password)

# Dump only real tables: materialized views are recreated by migrations on
# restore and INSERT INTO a view is invalid anyway.
clickhouse-client --password "$ch_password" --query "
    SELECT name FROM system.tables
    WHERE database = 'plausible_events_db'
      AND engine NOT IN ('MaterializedView', 'View', 'Dictionary', 'LiveView')
    ORDER BY name" | while read -r table; do
    clickhouse-client --password "$ch_password" \
        --query "SELECT * FROM plausible_events_db.\"$table\" FORMAT Native" \
        > "./clickhouse/${table}.native"
done

ynh_script_progression "Backup of $app prepared"
